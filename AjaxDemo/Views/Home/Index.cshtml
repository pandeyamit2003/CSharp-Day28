@{    ViewData["Title"] = "AJAX Demo";}<h2>Simple AJAX Example</h2><button id="btnClick">Get Message</button><h3 id="result"></h3><!-- jQuery Library --><script src="https://code.jquery.com/jquery-3.7.1.min.js"></script><!-- AJAX Script --><script>    $(document).ready(function () {    $("#btnClick").click(function () {    $.ajax({    url: '/Home/GetMessage',    type: 'GET',    success: function (response) {    $("#result").html(response.message);    },    error: function () {    alert("Error occurred");    }    });    });    });</script>